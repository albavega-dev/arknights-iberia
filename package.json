{
  "name": "arknights-iberia",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:components:coverage": "vitest run --config vitest.components.config.ts --coverage",
    "lint": "eslint",
    "format:css:check": "prettier --check src/app/globals.css src/app/operators/operators.css",
    "format:css": "prettier --write src/app/globals.css src/app/operators/operators.css",
    "check:encoding": "tsx scripts/check-text-encoding.ts --changed",
    "check:encoding:all": "tsx scripts/check-text-encoding.ts --all",
    "check:encoding:self-test": "tsx scripts/check-text-encoding.ts --self-test",
    "artists:normalize": "tsx scripts/normalize-operator-artist-credits.ts",
    "test:artist-credit-extractor": "tsx --test tests/artist-credit-extractor.test.ts",
    "test:operator-factions": "tsx --test tests/operator-factions.test.ts",
    "subpower:candidates": "node scripts/extract-subpower-candidates.mjs",
    "test:subpower-candidates": "node --test tests/extract-subpower-candidates.test.mjs",
    "test:unit": "tsx --test tests/artist-credit-extractor.test.ts tests/extract-subpower-candidates.test.mjs tests/operator-archetypes.test.ts tests/operator-biography-database-reader.test.ts tests/operator-biography-drizzle-adapter.test.ts tests/operator-biography-import.test.ts tests/operator-biography-local-factory.test.ts tests/operator-biography-local-pool.test.ts tests/operator-biography-reader.test.ts tests/operator-biography.test.ts tests/operator-detail-biography.test.ts tests/operator-factions.test.ts tests/operator-global-updates.test.ts tests/operator-sample.test.ts tests/operator-slugs.test.ts tests/operator-dataset.test.ts tests/operator-stats-generator.test.ts tests/verify-operator-regional-sets.test.ts tests/operator-bundle.test.ts tests/operator-bundle-import.test.ts tests/sync-cn-release-dates.test.ts",
    "test:unit:coverage": "c8 --reporter=lcov --reporter=text-summary corepack pnpm test:unit",
    "data:bundle:validate": "tsx scripts/validate-operator-bundle.ts",
    "data:bundle:generate": "tsx scripts/generate-operator-bundle.ts",
    "data:bundle:import": "tsx scripts/import-operator-bundle.ts",
    "data:bundle": "tsx scripts/import-operator-bundle.ts",
    "data:cn-sync": "tsx scripts/sync-cn-release-dates.ts",
    "data:stats:generate": "tsx scripts/generate-operator-stats.ts",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "assets:generate-illustrations": "node --import=tsx scripts/generate-operator-illustration-manifest.ts",
    "ranges:verify-modules": "tsx scripts/verify-operator-module-ranges.ts",
    "ranges:verify-associated": "node scripts/verify-associated-ranges.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.9",
    "@radix-ui/react-popover": "1.3.1",
    "better-auth": "1.7.9",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.58.0",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "c8": "10.1.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "^30.1.3",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module"
}
