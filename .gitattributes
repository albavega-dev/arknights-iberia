# Text files are stored and checked out with LF on every system; the datasets record byte sizes and hashes.
* text=auto eol=lf

# Images and other binary assets
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.ogg binary
*.wav binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
