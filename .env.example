# Copy to .env and set a unique local password before running Docker Compose.
# This file contains no usable credential.
POSTGRES_USER=arknights_local
POSTGRES_PASSWORD=
POSTGRES_DB=arknights_iberia

# Generated locally by `corepack pnpm db:setup-roles`; never commit real values.
APP_DB_USER=arknights_app
APP_DB_PASSWORD=
MIGRATION_DB_USER=arknights_migrator
MIGRATION_DB_PASSWORD=

# Local Compose is the default: loopback only, TLS disabled.
DB_CONNECTION_MODE=local
DB_HOST=127.0.0.1
DB_TLS_MODE=disable

# Future managed PostgreSQL only: use DB_CONNECTION_MODE=remote,
# DB_HOST=<provider DNS hostname>, DB_TLS_MODE=verify-full.
# Remote TLS validates the trusted CA and DNS hostname. Do not use an IP,
# connection URL, PGSSLMODE, DB_TLS_REJECT_UNAUTHORIZED, or a TLS bypass.
# Put real app and migrator credentials in separate server-side secret scopes.

# Optional Node.js pool settings; defaults shown, not remotely tuned.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=10000

# Local Better Auth infrastructure: set a unique random secret (32+ characters)
# only in the ignored .env or process environment before running Next.js.
# The URL must match the browser origin exactly; this phase permits localhost:3000.
# No real secret belongs in this example. Leave provider credentials unset.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Beta default: the Better Auth HTTP handler remains unavailable. Do not enable in production.
AUTH_PUBLIC_ENABLED=false
# Explicitly local-only. Requires next dev, loopback PostgreSQL and Mailpit.
# Keep false in production and every remote environment.
AUTH_LOCAL_EMAIL_ENABLED=false
# Optional local test override only; 3600 seconds by default (range 5..3600).
AUTH_LOCAL_RESET_TTL_SECONDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Both remain false until local OAuth apps, explicit linking and callback review.
# Never enable on a remote database or production host.
AUTH_LOCAL_GOOGLE_ENABLED=false
AUTH_LOCAL_DISCORD_ENABLED=false
